rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Feedback ──────────────────────────────────────────────────────────────
    // Skrivs ENBART av Admin SDK (feedback-routen), läses server-side/Console.
    // Default-deny för klienter — ingen kan läsa andras feedback.
    match /feedback/{doc} {
      allow read, write: if false;
    }

    // ── Meta (räknare för Founding Members m.m.) ──────────────────────────────
    // Skrivs ENBART av Admin SDK (server-side). Klienten får varken läsa eller
    // skriva — annars kan någon manipulera founding-räknaren.
    match /meta/{doc} {
      allow read, write: if false;
    }

    // ── Profiles ─────────────────────────────────────────────────────────────
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      // 'role' får ALDRIG ändras via Firestore-klienten — varken av ägaren
      // eller av en admin-klient. Bara Admin SDK (kringgår regler) får sätta
      // role-fältet. Utan denna regel kan en komprometterad admin-session
      // eskalera privilegier via Firestore SDK direkt.
      // 'totalXp' / 'level' / foundingMember sätts bara av Admin SDK server-side.
      allow update: if (isAdmin()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'totalXp', 'level', 'foundingMember', 'foundingNumber']))
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'totalXp', 'level', 'foundingMember', 'foundingNumber']));
      allow delete: if isAdmin();

      // XP-händelser skrivs ENBART av Admin SDK (bypassar regler). Läsbara
      // publikt så progress kan visas. Ingen klient får skriva direkt.
      match /xpEvents/{eventType} {
        allow read: if true;
        allow write: if false;
      }

      // Notiser: bara mottagaren läser/markerar lästa/raderar. Skapas ENBART
      // av Admin SDK (notify-routen) så ingen kan spamma andras notiser.
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(userId);
        allow create: if false;
      }
    }

    // ── Projects ─────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Admin: allt. Ägare: redigera eget innehåll men ALDRIG isFeatured/userId.
      // upvoteCount och commentCount uppdateras ENBART av Admin SDK via
      // /api/upvote och /api/comment — klienten har ingen direktskrivrätt.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['isFeatured', 'userId', 'upvoteCount', 'commentCount']));
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── Posts (hjälpfrågor, prompts, guider, diskussioner) ────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Samma princip som projects: featured och räknare är admin/server-only.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['isFeatured', 'userId', 'upvoteCount', 'commentCount']));
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── Comments on projects (sub-collection) ────────────────────────────────
    match /projects/{projectId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── Comments on posts (sub-collection) ───────────────────────────────────
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Kommentarägaren kan uppdatera sin kommentar.
      // Frågeägaren kan ENBART sätta isAccepted (för att markera accepterat svar).
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin()
        || (isSignedIn()
            && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAccepted']));
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── Votes ─────────────────────────────────────────────────────────────────
    match /votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false; // votes are immutable — delete and recreate
    }

    // ── Bookmarks ─────────────────────────────────────────────────────────────
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Reports ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Newsletter subscribers ────────────────────────────────────────────────
    // Skrivs och läses ENBART av Admin SDK (newsletter-routes).
    // Klienten får varken läsa eller skriva — e-postadresser ska inte exponeras.
    match /newsletter_subscribers/{doc} {
      allow read, write: if false;
    }
  }
}
